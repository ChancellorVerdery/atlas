# TLS front door for the Atlas WebSockets. sslip.io resolves the name to the
# server's own IP; Caddy auto-provisions the certificate (Let's Encrypt, ZeroSSL
# fallback) and keeps it renewed in the caddy-data volume. reverse_proxy passes
# WebSocket upgrades through natively. handle_path strips the prefix, so a plain
# GET returns each service's health line ("atlas-inbox" / "atlas-outbox").
# Everything else on the server (Postgres, Adminer, Portainer) stays SSH-only.
150-230-179-46.sslip.io {
	# Exact paths only: the services' other routes (e.g. the outbox's internal
	# POST /deliver) must never be reachable from outside.
	handle_path /inbox {
		reverse_proxy atlas-inbox:80
	}
	handle_path /outbox {
		reverse_proxy atlas-outbox:80
	}
	respond 404
}
