# Atlas monorepo — atlas-ui, atlas-backend, notes-ink, server console app.

# Dependencies + build output (restorable from package-lock / a build)
# Both spellings: the trailing slash misses a node_modules SYMLINK, which is how
# a git worktree usually gets its deps (linked from the main checkout).
node_modules/
node_modules
dist/
dist-app/

# QA screenshot baselines: 81 MB of PNGs. Regenerate with tmp-e2e/_qa-baseline.mjs
# rather than carry them in every clone. Test SCRIPTS (*.mjs) are tracked.
atlas-ui/tmp-e2e/_qa/
atlas-ui/tmp-e2e/**/*.png

# Secrets never belong here — the real ones live only on the servers
# (~/atlas-backend/.google.env, ~/stack/.env, ~/.app-password, ~/.pgpass).
# These rules are belt-and-braces in case one is ever copied down.
.env
.env.*
*.pgpass
.google.env
*.pem
*.key
.app-password

# Built plugin zips — regenerate with tools/build-plugin-zips.mjs
plugins-dist/

# Xcode derived data — build.sh writes build/ (mac + simulator) and
# build-device/ (signed device builds). Pure build output; regenerate with
# atlas-apple/build.sh. 135 of these files got committed once by a `git add -A`.
atlas-apple/build/
atlas-apple/build-device/
# and build-test/ (xcodebuild build-for-testing, for the XCUITest runner)
atlas-apple/build-test/

# Retired-plugin archive (formal/graph/finance source zips + exported data) —
# lives on the Desktop beside the repo, never committed.
custom plugins/

.DS_Store

.claude/worktrees/
