:80 {
	basic_auth {
		chancellor __HASH__
	}
	handle /shell* {
		reverse_proxy 127.0.0.1:7681
	}
	handle_path /db* {
		# adminer 5 also refuses framing; it lives inside our tab, so strip it
		reverse_proxy 127.0.0.1:8082 {
			header_down -X-Frame-Options
			header_down -Content-Security-Policy
		}
	}
	# Git board: python stdlib service over the bare mirror at ~/git/atlas.git.
	# handle_path strips /git, so the page loads at /git/ and its relative
	# fetches land on /git/api/*. Read-only, and basic_auth above covers it.
	handle_path /git* {
		reverse_proxy 127.0.0.1:7682
	}

	# Docker tab. Portainer cannot be told to live under a sub-path — it serves
	# its SPA from / with absolute asset and API URLs — so it gets mounted at
	# /docker/ and everything it then asks for at the top level falls through to
	# it via the catch-all below. That is why the console's own static file
	# server is pinned to exactly "/" rather than being the fallback: the
	# fallback has to belong to Portainer.
	# inside a handle so it is mutually exclusive with the blocks below rather
	# than depending on where caddy sorts a bare redir
	handle /docker {
		redir * /docker/
	}
	handle_path /docker/* {
		reverse_proxy 127.0.0.1:9002 {
			header_down -Content-Security-Policy
		}
	}

	handle / {
		root * /srv
		file_server
	}

	# Portainer's absolute paths (/api/*, /assets/*, …). Unmatched paths reaching
	# Portainer is fine; it serves its own SPA fallback.
	handle {
		reverse_proxy 127.0.0.1:9002 {
			header_down -Content-Security-Policy
		}
	}
}

# The :9001 listener is gone. It proxied straight to Portainer with no
# basic_auth, bound to every interface, and cloudflared published it as
# portainer.<domain> — so the Docker socket, which is root on this box, sat on
# the open internet behind nothing but Portainer's own login. Portainer is now
# reachable only as /docker/ on the console above, behind the console's basic
# auth and the SSH-key gate, with 127.0.0.1:9002 supplying the session.
#
# Nothing else may expose 9000 or 9002. The auto-login proxy answers every
# request as an authenticated admin, so an unauthenticated route to it is a
# full compromise, not a degraded one.

# Atlas sync WebSockets — public via cloudflared (sync.myatlasapp.net -> here).
# No basic_auth: the services behind this block authenticate every request
# themselves, and the listener is loopback-only behind cloudflared. (This used
# to justify itself by pointing at the Oracle caddy, which no longer exists —
# the reason stands on its own.) Exact paths only — the outbox's POST /deliver must
# never be reachable from outside. Port-only address so any Host header
# matches (cloudflared forwards Host: sync.myatlasapp.net); bind keeps the
# listener off the LAN.
:8090 {
	bind 127.0.0.1
	handle_path /inbox {
		reverse_proxy 127.0.0.1:8100
	}
	handle_path /outbox {
		reverse_proxy 127.0.0.1:8101
	}
	handle_path /uiapi* {
		reverse_proxy 127.0.0.1:8102
	}
	respond 404
}
